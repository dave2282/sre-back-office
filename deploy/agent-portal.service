# /etc/systemd/system/agent-portal.service
# sudo systemctl daemon-reload && sudo systemctl enable --now agent-portal
[Unit]
Description=Signature Real Estate Agent Portal
After=network.target

[Service]
Type=simple
User=portal
WorkingDirectory=/opt/agent-portal
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
