# Copy to .env and fill in. Restart the app after changes.

# ---- Basics -----------------------------------------------------------------
# Public address people use to reach the portal (used in email links + OAuth callbacks)
APP_URL=https://agents.resignature.com
PORT=3000
# Where the database, uploads and email outbox live (back this folder up!)
DATA_DIR=./data
# Optional: long random string. If blank, one is generated and saved in DATA_DIR/.jwt_secret
JWT_SECRET=
SESSION_DAYS=30
MAX_UPLOAD_MB=100

# ---- Email (SMTP) -------------------------------------------------------------
# Google Workspace: smtp.gmail.com / 587 / your address / an App Password
# Microsoft 365:   smtp.office365.com / 587
# Without SMTP, emails are saved to DATA_DIR/outbox instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=office@resignature.com

# ---- AI (Smart File Upload, document auto-audit, CDA import) -------------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Cloud file storage (optional — connect from Brokerage Settings → File Storage) ----
# Top-level folder created in the connected Drive / Dropbox
STORAGE_ROOT_FOLDER=Agent Portal
# Google Drive: OAuth client from Google Cloud Console (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dropbox: app from https://www.dropbox.com/developers/apps (see README)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
